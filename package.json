{
    "name": "aseprite-preview",
    "displayName": "Aseprite Preview",
    "description": "Preview Aseprite files (.aseprite, .ase) directly in VS Code with animation support",
    "version": "0.0.1",
    "publisher": "aseprite-preview",
    "repository": {
        "type": "git",
        "url": "https://github.com/your-username/aseprite-preview"
    },
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "aseprite",
        "pixel art",
        "sprite",
        "animation",
        "preview"
    ],
    "activationEvents": [
        "onCustomEditor:aseprite-preview.asepriteEditor"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "customEditors": [
            {
                "viewType": "aseprite-preview.asepriteEditor",
                "displayName": "Aseprite Preview",
                "selector": [
                    {
                        "filenamePattern": "*.aseprite"
                    },
                    {
                        "filenamePattern": "*.ase"
                    }
                ],
                "priority": "default"
            }
        ],
        "commands": [
            {
                "command": "aseprite-preview.toggleAnimation",
                "title": "Toggle Animation",
                "category": "Aseprite Preview"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@types/vscode": "^1.74.0",
        "@types/node": "16.x",
        "prettier": "^3.6.2",
        "typescript": "^4.9.4"
    }
}
